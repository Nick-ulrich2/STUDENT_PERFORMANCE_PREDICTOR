NEXT_PUBLIC_SUPABASE_URL=<placeholder>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<placeholder>
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Canonical public URL of this deployment, used for the sitemap, robots.txt,
# canonical/Open Graph tags and the generated OG image. Set this to the real
# production domain (e.g. https://spp.vercel.app) once deployed; defaults to
# localhost for local dev so SEO code never crashes with it unset.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
