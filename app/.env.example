# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Use only from trusted application code as appropriate.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend-only key. Never expose it to a frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT audience used by the backend when validating the Supabase access token.
SUPABASE_JWT_AUDIENCE=authenticated

# Canonical local frontend origin.
FRONTEND_ORIGIN=http://127.0.0.1:3001

# Optional: enables AI-generated recommendations on POST /predict/recommendation
# (roadmap Phase 6). Free API key, no credit card: https://console.groq.com/keys
# Leave GROQ_API_KEY empty to disable the feature; every other route keeps working.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b